# API user token, used by the Vite dev server to create end users and issue
# end-user auth tokens. Org-wide authority — deliberately NOT prefixed with
# VITE_, so Vite never inlines it into the client bundle. Keep it out of git.
FORDEFI_API_USER_TOKEN=

# Optional. Defaults to https://api.fordefi.com.
# Only change this if Fordefi Technical Support directed you to another environment.
FORDEFI_API_BASE_URL=

# Test-only AES-256 backup key for the external-encryption flow.
# Generate with: openssl rand -base64 32
# Reaches the browser by design (the SDK encrypts client-side), so this is a
# throwaway dev value — never a real user key.
FORDEFI_TEST_BACKUP_KEY=

# Optional. Defaults to https://api.devnet.solana.com.
# The balance panel reads the vault's SOL and SPL balances straight from the chain.
# The public endpoint rate-limits hard, so point this at Helius/QuickNode/etc. if
# refreshes start coming back 429.
SOLANA_DEVNET_RPC_URL=
